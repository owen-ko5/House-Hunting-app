# Copy this to .env for local development (never commit .env itself)
FLASK_ENV=development
JWT_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///app.db
FRONTEND_URL=http://localhost:3001

# --- Optional production/ops settings ---
# Error tracking (Sentry). Leave unset to disable.
SENTRY_DSN=
# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Rate-limit storage. Use redis://... across multiple instances/dynos —
# the default in-memory store only works correctly on a single instance.
RATELIMIT_STORAGE_URI=memory://
